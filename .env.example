# ── PostgreSQL (pgvector) ──────────────────────────────────────────────────────
# Запускается через: docker-compose up -d
LOGFUZZY_PG_DSN=postgresql://logfuzzy:logfuzzy@localhost:5432/logfuzzy

# ── Ollama ─────────────────────────────────────────────────────────────────────
# Ollama должен быть запущен локально.
# Нужные модели:
#   ollama pull nomic-embed-text   (эмбеддинги, 768 dim)
#   ollama pull llama3.2           (советы по инцидентам)
OLLAMA_BASE_URL=http://localhost:11434

# Модель для эмбеддингов
EMBED_MODEL=nomic-embed-text
# Размерность эмбеддингов (768 для nomic-embed-text, 1024 для mxbai-embed-large)
EMBED_DIM=768

# LLM для генерации советов
LLM_MODEL=llama3.2

# ── SQLite (существующая БД логов) ─────────────────────────────────────────────
# По умолчанию: backend/storage/log_fuzzy.sqlite3
# LOGFUZZY_DB_PATH=C:\temp\log_fuzzy.sqlite3
